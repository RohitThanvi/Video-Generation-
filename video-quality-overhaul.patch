+          el.classList.add('is-active');
+          startCounters(el, t);
+        }
+        // The last scene holds its final frame; every other scene fades out at its end.
+        if (i < last && t >= s.end && s.state === 'active') {
+          s.state = 'leaving';
+          el.classList.add('is-leaving');
+        }
