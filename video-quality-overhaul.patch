+        json.dumps({"scenes": [{"id": "s1", "duration_seconds": 6, "narration": "s1.wav"}]})
+    )
+    result = validation.validate_project(project)
+    assert not result["valid"]
+    assert "at least 7.5" in " ".join(result["errors"])  # 0.6 lead + 6.0 + 0.8 hold -> 7.5
