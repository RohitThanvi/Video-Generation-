+<!doctype html>
+<html>
+<head>
+  <meta charset="utf-8" />
+  <title>Cartoon explainer</title>
+  <style>
+    html, body { margin: 0; height: 100%; overflow: hidden; background: #8fd3ff; }
+    svg { position: fixed; inset: 0; width: 100vw; height: 100vh; }
+    #caption {
+      position: fixed; top: 70px; left: 0; right: 0; text-align: center;
+      font: 700 76px 'DejaVu Sans', Arial, sans-serif; color: #17324d; opacity: 0;
+    }
+    .cloud { animation: drift 8s linear forwards; }
+    @keyframes drift { from { transform: translateX(0); } to { transform: translateX(260px); } }
+  </style>
+</head>
+<body>
+<svg viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice">
+  <defs>
+    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
+      <stop offset="0" stop-color="#5ab8ff" /><stop offset="1" stop-color="#d9f2ff" />
+    </linearGradient>
+    <radialGradient id="ballGrad" cx="35%" cy="30%" r="75%">
+      <stop offset="0" stop-color="#ff9a8a" /><stop offset="1" stop-color="#e5334b" />
+    </radialGradient>
+  </defs>
+  <rect width="1920" height="1080" fill="url(#sky)" />
+  <circle cx="1560" cy="230" r="95" fill="#ffe27a" />
+  <g class="cloud" fill="#fff" opacity=".95">
+    <ellipse cx="300" cy="300" rx="130" ry="48" /><ellipse cx="380" cy="270" rx="90" ry="50" /><ellipse cx="230" cy="282" rx="70" ry="38" />
+  </g>
+  <g class="cloud" fill="#fff" opacity=".9" style="animation-duration: 8s">
+    <ellipse cx="1100" cy="190" rx="110" ry="40" /><ellipse cx="1170" cy="165" rx="75" ry="42" />
+  </g>
+  <path d="M0 800 Q 500 640 960 780 T 1920 760 V1080 H0Z" fill="#7bd36b" />
+  <rect y="880" width="1920" height="200" fill="#5bb34e" />
+  <ellipse id="shadow" cx="960" cy="905" rx="110" ry="22" fill="#000" opacity=".25" />
+  <g id="ball">
+    <circle r="100" fill="url(#ballGrad)" />
+    <ellipse cx="-34" cy="-40" rx="26" ry="16" fill="#fff" opacity=".55" transform="rotate(-30 -34 -40)" />
+  </g>
+</svg>
+<div id="caption"></div>
+
+<script src="/vendor/gsap/dist/gsap.min.js"></script>
+<script>
+  // Everything is a function of time: build a paused timeline and seek it each frame.
+  const GROUND = 805;     // y of the ball centre when it touches the floor
+  gsap.set('#ball', { x: 960, y: 230, transformOrigin: '50% 100%' });
+
+  const tl = gsap.timeline({ paused: true });
+  const caption = document.getElementById('caption');
+  const say = (text, at) => {
+    tl.call(() => { caption.textContent = text; }, null, at);
+    tl.fromTo(caption, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.4 }, at);
+  };
+
+  say('Gravity pulls it down...', 0.2);
+  let t = 0.2;
+  [230, 430, 600].forEach((fromY, i) => {
+    const fall = 0.62 - i * 0.1;
+    tl.to('#ball', { y: GROUND, duration: fall, ease: 'power2.in' }, t);                         // fall
+    tl.to('#ball', { scaleY: 1.18, scaleX: 0.9, duration: fall * 0.9, ease: 'none' }, t);        // stretch
+    t += fall;
+    tl.to('#ball', { scaleY: 0.62, scaleX: 1.35, duration: 0.07, ease: 'power1.out' }, t);       // squash
+    tl.to('#ball', { scaleY: 1.0, scaleX: 1.0, duration: 0.18, ease: 'elastic.out(1,.4)' }, t + 0.07);
+    const nextTop = i < 2 ? [430, 600, 740][i] : null;
+    if (nextTop !== null) {
+      tl.to('#ball', { y: nextTop, duration: fall * 0.95, ease: 'power2.out' }, t + 0.07);
+      t += 0.07 + fall * 0.95;
+    }
+  });
+  tl.to('#shadow', { attr: { rx: 150 }, opacity: 0.35, duration: 0.3 }, 0.2);
+  say('...and squash & stretch sells the weight.', 2.6);
+  tl.to('#ball', { x: 2200, rotation: 720, duration: 2.2, ease: 'power2.in' }, 5.2);
+  tl.to('#shadow', { x: 1240, opacity: 0, duration: 2.2, ease: 'power2.in' }, 5.2);
+  tl.to(caption, { opacity: 0, duration: 0.4 }, 7.4);
+
+  window.__renderFrame = (tMs) => { tl.time(Math.min(tMs / 1000, tl.duration()), false); };
+  if (!window.__VIDEO_EXPORT__) tl.play();
+</script>
+</body>
+</html>
