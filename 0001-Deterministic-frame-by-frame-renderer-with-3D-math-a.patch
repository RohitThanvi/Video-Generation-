+<!doctype html>
+<html>
+<head>
+  <meta charset="utf-8" />
+  <title>3D scene</title>
+  <style>
+    html, body { margin: 0; background: #05060f; overflow: hidden; }
+    canvas { display: block; }
+    #title {
+      position: fixed; left: 0; right: 0; bottom: 90px; text-align: center;
+      font: 600 64px 'DejaVu Sans', Arial, sans-serif; color: #fff; letter-spacing: 2px;
+      text-shadow: 0 4px 30px rgba(88, 196, 221, .8);
+      opacity: 0; animation: rise 1.5s 1s ease-out forwards;
+    }
+    @keyframes rise { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: none; } }
+  </style>
+</head>
+<body>
+<div id="title">Real-time 3D, frame-perfect</div>
+<script type="module">
+  import * as THREE from 'three';
+
+  const width = window.innerWidth;
+  const height = window.innerHeight;
+
+  const renderer = new THREE.WebGLRenderer({ antialias: true, preserveDrawingBuffer: true });
+  renderer.setPixelRatio(1);
+  renderer.setSize(width, height);
+  document.body.prepend(renderer.domElement);
+
+  const scene = new THREE.Scene();
+  scene.background = new THREE.Color(0x05060f);
+  scene.fog = new THREE.Fog(0x05060f, 8, 22);
+
+  const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
+
+  const knot = new THREE.Mesh(
+    new THREE.TorusKnotGeometry(1, 0.32, 256, 48, 2, 3),
+    new THREE.MeshStandardMaterial({ color: 0x58c4dd, metalness: 0.65, roughness: 0.22 }),
+  );
+  scene.add(knot);
+
+  const colors = [0xfc6255, 0xffff00, 0x83c167, 0xff862f, 0x9a72ac, 0xd147bd];
+  const spheres = colors.map((color) => {
+    const mesh = new THREE.Mesh(
+      new THREE.SphereGeometry(0.22, 48, 32),
+      new THREE.MeshStandardMaterial({ color, emissive: color, emissiveIntensity: 0.35, roughness: 0.3 }),
+    );
+    scene.add(mesh);
+    return mesh;
+  });
+
+  const floor = new THREE.GridHelper(40, 60, 0x2a3a5a, 0x151c30);
+  floor.position.y = -2.2;
+  scene.add(floor);
+
+  scene.add(new THREE.AmbientLight(0xffffff, 0.35));
+  const key = new THREE.DirectionalLight(0xffffff, 2.2);
+  key.position.set(4, 6, 5);
+  scene.add(key);
+  const warm = new THREE.PointLight(0xff862f, 60, 20);
+  const cool = new THREE.PointLight(0x58c4dd, 60, 20);
+  scene.add(warm, cool);
+
+  function frame(t) {
+    knot.rotation.set(t * 0.5, t * 0.8, 0);
+    spheres.forEach((mesh, i) => {
+      const a = t * (0.9 + i * 0.12) + (i * Math.PI * 2) / spheres.length;
+      const r = 2.3 + 0.35 * Math.sin(t + i);
+      mesh.position.set(Math.cos(a) * r, Math.sin(a * 1.3 + i) * 0.9, Math.sin(a) * r);
+    });
+    warm.position.set(Math.cos(t * 1.2) * 4, 2, Math.sin(t * 1.2) * 4);
+    cool.position.set(-Math.cos(t * 0.9) * 4, -1, -Math.sin(t * 0.9) * 4);
+    camera.position.set(Math.cos(t * 0.35) * 7, 1.6 + Math.sin(t * 0.5) * 0.8, Math.sin(t * 0.35) * 7);
+    camera.lookAt(0, 0, 0);
+    renderer.render(scene, camera);
+  }
+
+  // The renderer calls this once per video frame with the exact time. (Using
+  // requestAnimationFrame + THREE.Clock also works: the clock is virtual.)
+  window.__renderFrame = (tMs) => frame(tMs / 1000);
+  frame(0);
+  if (!window.__VIDEO_EXPORT__) renderer.setAnimationLoop(() => frame(performance.now() / 1000));
+</script>
+</body>
+</html>
