+    def close(self):
+        try:
+            self._proc.stdin.close()
+        except (BrokenPipeError, OSError):
+            pass
+        code = self._proc.wait()
+        if code != 0:
+            raise RuntimeError(f"ffmpeg failed (exit {code}):\n{self._error()}")
