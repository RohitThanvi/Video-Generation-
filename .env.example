GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# LLM budget shared by all jobs. Set LLM_TPM/LLM_RPM to your Groq plan's limits so calls wait
# instead of failing with 429. GROQ_FALLBACK_MODEL is tried when the main model keeps failing.
LLM_TPM=0
LLM_RPM=0
LLM_CONCURRENCY=2
GROQ_FALLBACK_MODEL=
JOB_WORKERS=3
RENDER_CONCURRENCY=1

API_HOST=127.0.0.1
API_PORT=8000

# Relative paths are resolved against the repository, not the current directory.
PROJECT_ROOT=./projects
# Only for docker-compose: the absolute HOST path of ./projects (e.g. /home/me/Video-Generation-/projects).
# Leave empty when running uvicorn directly.
HOST_PROJECT_ROOT=

SANDBOX_IMAGE=ai-video-sandbox:latest
SANDBOX_MEMORY=6g
SANDBOX_CPUS=4
SANDBOX_PIDS_LIMIT=256
SANDBOX_TIMEOUT_SECONDS=3600

# Agent may search openly licensed images (Openverse, no key) and download assets on the host.
ALLOW_WEB_ASSETS=true

DEFAULT_FPS=30
DEFAULT_WIDTH=1920
DEFAULT_HEIGHT=1080

MAX_PROJECT_BYTES=2147483648
MAX_FILE_BYTES=52428800
