+    )
+    with pytest.raises(docker_runner.DockerError, match="timed out"):
+        docker_runner.run_in_sandbox(project, ["true"])
+    run_cmd, kill_cmd = calls
+    name = run_cmd[run_cmd.index("--name") + 1]
+    assert kill_cmd == ["docker", "kill", name]
+
