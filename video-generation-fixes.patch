+class _StubEngine:
+    def __init__(self, writes):
+        self.writes = writes
+        self.path = None
+        self.props = {}
+
+    def setProperty(self, key, value):
+        self.props[key] = value
+
+    def save_to_file(self, text, path):
+        self.path = path
+
+    def runAndWait(self):
+        if self.writes:
+            Path(self.path).write_bytes(b"RIFFdata")
+
