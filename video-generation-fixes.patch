+def _stub_pyttsx3(monkeypatch, writes):
+    engine = _StubEngine(writes)
+    module = type(sys)("pyttsx3")
+    module.init = lambda: engine
+    monkeypatch.setitem(sys.modules, "pyttsx3", module)
